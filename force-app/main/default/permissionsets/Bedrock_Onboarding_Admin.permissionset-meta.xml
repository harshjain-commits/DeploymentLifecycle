<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Full access to the Bedrock Financial Onboarding Request object. Assign to advisors, partner liaisons, and the BF onboarding operations team.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Bedrock Onboarding Admin</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Onboarding_Request__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!--
      Customer_Name__c, Division__c, and Status__c are all marked
      required=true on their field metadata, so Salesforce grants
      read/edit implicitly for every user with object access. Declaring
      fieldPermissions for a universally-required field fails deployment
      with "You cannot deploy to a required field". They are intentionally
      omitted from this permission set.
    -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Onboarding_Request__c.Net_Worth_Tier__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Onboarding_Request__c.Priority__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Onboarding_Request__c.Submitted_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Onboarding_Request__c.Risk_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Onboarding_Request__c.Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Onboarding_Request__c.Source_Channel__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <tabSettings>
        <tab>Onboarding_Request__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <classAccesses>
        <apexClass>OnboardingRequestService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>OnboardingRequestTriggerHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
