# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# CI/CD secrets - JWT keys and certs must never be committed.
# Generated by scripts/ci/generate-jwt-cert.sh and uploaded to
# GitHub Secrets as SFDX_JWT_KEY / uploaded to the Connected App
# in Salesforce as server.crt.
ci/keys/
*.key
*.pem
*.crt
*.der
*.p12
*.pfx
server.key
server.crt

# CI/CD local artefacts
sca-report.*
test-results/
evidence/
.auth.txt
auth.txt

# Local recovery/backup files
*.local-backup
*.bak

# Original recovered PPTX (not for source control)
docs/Bedrock_DevSecOps_Strategy_ORIGINAL.pptx

# Presentation deliverables and background materials - kept locally,
# not versioned in this repo (per project policy: source code only).
docs/

# PPTX build tooling used to (re)generate the presentation - local only.
scripts/pptx/
